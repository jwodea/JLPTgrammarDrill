      "id": "n5_002_7",
      "example_sentence": "宿題をします。",
      "translation": "I do my homework.",
      "blank_target": "を",
      "wrong_choices": [
        "は",
        "へ",
        "と"
      ],
      "wrong_choice_explanations": [
        "は marks the topic; を is the standard object marker for します.",
        "へ marks a direction of movement and cannot mark 宿題 as the thing you do; を marks it as the direct object.",
        "と means 'with' or 'and'; 宿題とします does not mark the object — を is needed for what you do."
      ],
      "hiragana_full": "しゅくだいをします。",
      "audio_alternatives": [
        {
          "kanji": "宿題をする。",
          "hiragana_full": "しゅくだいをする。"
        },
